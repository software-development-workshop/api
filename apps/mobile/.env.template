# Public backend service base URLs (must NOT include /api/v1 suffix).
# These origins are embedded into the client bundle and accessed directly by the mobile app.
#
# IMPORTANT: Copy this file to .env and replace the illustrative private LAN IP
# (192.168.1.50) with your computer's actual reachable LAN IPv4 address, or with
# deployed HTTPS backend origins. Do NOT use localhost or 127.0.0.1 when running
# on a physical phone: localhost on a phone resolves to the phone itself.
#
# No backend secrets, signing keys, mail credentials, or passwords belong here.

EXPO_PUBLIC_ACCOUNTS_API_URL=http://192.168.1.50:8000
EXPO_PUBLIC_POSTS_API_URL=http://192.168.1.50:8001
