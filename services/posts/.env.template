# Copy to .env and fill in the values. Never commit credentials.

# --- Database ---
DB_HOST=               # database server address
DB_PORT=               # database server port
DB_NAME=               # database name this service connects to
DB_USER=               # database login
DB_PASSWORD=           # database login password

# --- Accounts service ---
ACCOUNTS_BASE_URL=          # base URL used for session introspection
ACCOUNTS_TIMEOUT_SECONDS=   # positive HTTP timeout in seconds, e.g. 2
