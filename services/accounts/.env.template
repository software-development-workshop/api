# Copy to .env and fill in the values. Ask the team for them — they are shared through the
# password manager, never through Slack, a commit, or a message.
#
# This file is committed. `.env` is not. A secret that reaches git history stays in git
# history.
#
# Every variable the service reads must be listed here, with no value and a comment saying
# what it is. A variable that only exists on one laptop breaks the build for everyone else.

# --- Database ---
DB_HOST=               # database server address
DB_PORT=               # database server port
DB_NAME=               # database name this service connects to
DB_USER=               # database login
DB_PASSWORD=           # database login password

# --- Email ---
SMTP_HOST=             # smtp server address
SMTP_PORT=             # smtp server port
SMTP_FROM=             # address the verification email is sent from
PUBLIC_BASE_URL=       # where the verification link points, e.g. https://api.udesa-x.dev

# --- Authentication ---
JWT_SECRET=            # at least 32 random bytes used to sign access tokens
